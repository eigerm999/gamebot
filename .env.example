# Copy to .env (gitignored). Never commit real values.

# Shared with Laravel (BOT_WORKER_SECRET). At least 32 characters: `openssl rand -hex 32`.
WORKER_SECRET=
WORKER_PORT=8918

# Portal logins: copy accounts.example.json to accounts.json (gitignored).
# Each account gets its own browser profile, login and queue.
ACCOUNTS_FILE=accounts.json

# Browser. Visible by default for local development; true on servers.
HEADLESS=false
PROFILE_ROOT=runtime/profiles

# Milliseconds. Pre-submission work must finish within SUBMIT_DEADLINE_MS of the
# request arriving; SUBMIT_DEADLINE_MS + SUBMIT_TIMEOUT_MS must stay below the
# caller's timeout (Laravel BOT_WORKER_TIMEOUT) so it never gives up mid-change.
NAV_TIMEOUT_MS=60000
FETCH_TIMEOUT_MS=15000
SUBMIT_TIMEOUT_MS=30000
SUBMIT_DEADLINE_MS=35000
# Requests allowed to wait per account before new ones get an immediate "busy".
MAX_WAITING=3

# ---- Shared proxy ----
# One proxy (e.g. Webshare: static IP, rotation OFF) for the accounts listed in
# PROXY_ACCOUNTS, comma separated account keys from accounts.json. Accounts not
# listed connect directly; empty = proxy off. Restart the worker after changing.
PROXY_ACCOUNTS=
PROXY_SERVER=
PROXY_USERNAME=
PROXY_PASSWORD=

# ---- Account secrets, referenced by name from accounts.json ----
# Only use with portal accounts you are authorized to automate.
YES918_0038_USERNAME=
YES918_0038_PASSWORD=
# Second-step password. Leave it out of accounts.json if it is the same as the password.
YES918_0038_PASSWORD2=

# Example second login (YESNG-0039); remove it from accounts.json if you do not use it.
YES918_0039_USERNAME=
YES918_0039_PASSWORD=

# Wudi account (captcha must be disabled for unattended login)
WUDI_SPADIK_USERNAME=
WUDI_SPADIK_PASSWORD=
