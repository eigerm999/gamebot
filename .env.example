# Copy to .env (gitignored). Never commit real values.

# Shared with Laravel (BOT918_WORKER_SECRET). At least 32 characters: `openssl rand -hex 32`.
WORKER_SECRET=
WORKER_PORT=8918

# Comma-separated providers to run. Each gets its own browser profile, login and queue.
PROVIDERS=yes918

# Browser. Visible by default for local development; true on servers.
HEADLESS=false
PROFILE_ROOT=runtime/profiles

# Milliseconds. Pre-submission work must finish within SUBMIT_DEADLINE_MS of the
# request arriving; SUBMIT_DEADLINE_MS + SUBMIT_TIMEOUT_MS must stay below the
# caller's timeout (Laravel BOT918_TIMEOUT) so it never gives up mid-change.
NAV_TIMEOUT_MS=60000
FETCH_TIMEOUT_MS=15000
SUBMIT_TIMEOUT_MS=30000
SUBMIT_DEADLINE_MS=35000
# Requests allowed to wait per provider before new ones get an immediate "busy".
MAX_WAITING=3

# ---- yes918 (only use with an account you are authorized to automate) ----
YES918_BASE_URL=https://example-yes918-portal.invalid
YES918_USERNAME=
YES918_PASSWORD=
# Second-step password. Leave empty if it is the same as YES918_PASSWORD.
YES918_PASSWORD2=
# Agent that owns new players. Defaults to YES918_USERNAME.
YES918_AGENT_USERNAME=
YES918_HOME_PATH=/search
YES918_PLAYER_NAME=
YES918_PLAYER_REMARK=
# Must not exceed Laravel BOT918_MAX_INITIAL_SCORE.
YES918_MAX_INITIAL_SCORE=50
# Optional static proxy (e.g. Webshare, rotation OFF): http://host:port
YES918_PROXY_SERVER=
YES918_PROXY_USERNAME=
YES918_PROXY_PASSWORD=
